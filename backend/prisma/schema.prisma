generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password      String   // Hashed
  role          String   @default("USER") // 'USER' | 'MODERATOR'
  ratingAverage Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationship: A user can own many services
  services  ServiceListing[]

  // Inverse relations for trades
  proposedTrades TradeProposal[] @relation("ProposerTrades")
  receivedTrades TradeProposal[] @relation("ReceiverTrades")

  // Notifications
  notifications Notification[]

  // Ratings
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  @@map("users")
}

model ServiceListing {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Sprint 4 - Marketplace visibility (soft delete)
  isActive       Boolean  @default(true)
  deactivatedAt  DateTime?

  // Foreign Key
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  // Inverse relations for referential integrity
  tradesAsProposer TradeProposal[] @relation("ProposerService")
  tradesAsReceiver TradeProposal[] @relation("ReceiverService")

  @@map("service_listings")
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model TradeProposal {
  id        String      @id @default(uuid())
  status    TradeStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Optional note/message from proposer
  note      String?

  // Contact (shared by receiver when accepting)
  contactWhatsapp String?

  // Who proposes
  proposerId String
  proposer   User   @relation("ProposerTrades", fields: [proposerId], references: [id])

  // Who receives
  receiverId String
  receiver   User   @relation("ReceiverTrades", fields: [receiverId], references: [id])

  // What proposer offers
  proposerServiceId String
  proposerService   ServiceListing @relation("ProposerService", fields: [proposerServiceId], references: [id])

  // What receiver offers
  receiverServiceId String
  receiverService   ServiceListing @relation("ReceiverService", fields: [receiverServiceId], references: [id])

  // Notifications context
  notifications Notification[]

  // Ratings
  ratings Rating[]

  @@map("trade_proposals")
}

model Rating {
  id        String   @id @default(uuid())
  score     Int
  comment   String?
  tags      String[]
  createdAt DateTime @default(now())

  tradeId   String
  trade     TradeProposal @relation(fields: [tradeId], references: [id])

  raterId   String
  rater     User @relation("RatingsGiven", fields: [raterId], references: [id])

  rateeId   String
  ratee     User @relation("RatingsReceived", fields: [rateeId], references: [id])

  @@unique([tradeId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // e.g., 'TRADE_PROPOSAL', 'TRADE_ACCEPTED'
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Recipient
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Optional reference to trade
  tradeId String?
  trade   TradeProposal? @relation(fields: [tradeId], references: [id])

  @@map("notifications")
}
